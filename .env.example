PORT=3000

# Use the data center selected for your Deye Cloud account:
# EU: https://eu1-developer.deyecloud.com
# US: https://us1-developer.deyecloud.com
# India: https://india-developer.deyecloud.com
DEYE_API_BASE_URL=https://eu1-developer.deyecloud.com
DEYE_API_TIMEOUT_MS=10000
DEYE_APP_ID=
DEYE_APP_SECRET=

# Set exactly one account identity.
DEYE_EMAIL=
# DEYE_USERNAME=
# DEYE_MOBILE=
# DEYE_COUNTRY_CODE=

# Set exactly one password option. Plaintext is SHA-256 hashed before sending.
DEYE_PASSWORD=
# DEYE_PASSWORD_SHA256=

# Optional: company ID for a business account.
# DEYE_COMPANY_ID=

# First-release testing forces console logging even if TG_DELIVERY=telegram.
TG_DELIVERY=console
TG_TOKEN=
TG_CHAT_ID=
